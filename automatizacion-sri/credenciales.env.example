# Copia este archivo a "credenciales.env" (sin ".example") en esta misma
# carpeta y completa tus datos reales. El archivo "credenciales.env" NUNCA
# debe compartirse, subirse a git ni enviarse a nadie: se queda solo en tu
# computadora y solo lo lee el script cuando corre.

# Credenciales de SRI en Línea (las mismas que usas para entrar a
# https://srienlinea.sri.gob.ec)
SRI_USUARIO=tu_ruc_o_cedula
SRI_CLAVE=tu_clave_del_sri

# Opcional: solo si tu login al SRI pide "C.I. adicional" (por ejemplo,
# si entras como contador/tercero autorizado a la cuenta de otra persona).
# Si entras con tu propia cuenta, déjalo vacío o bórralo.
SRI_CI_ADICIONAL=

# Credenciales de TU cuenta en la app FinTech (correo/contraseña con los
# que inicias sesión en la app, NO tus credenciales del SRI)
APP_CORREO=tu_correo@ejemplo.com
APP_CONTRASENA=tu_contrasena_de_la_app
